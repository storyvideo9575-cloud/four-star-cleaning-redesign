# ==============================================================================
# Four Star General Cleaning Service - Environment Configuration
# Quote Form Notification Architecture & Integrations
# ==============================================================================

# System Modes (Demo mode enabled by default for privacy & security)
# Set to 'false' only after explicit written authorization and full credentials setup.
DEMO_MODE=true
NOTIFICATIONS_ENABLED=false

# Secure Database Connection (PostgreSQL / Supabase / Neon / Cloud SQL)
# Required for production lead persistence prior to notification dispatch.
DATABASE_URL=

# Meta WhatsApp Business Platform Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OWNER_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=lead_notification_alert

# Email Backup Provider (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@4starcleaning.com
EMAIL_TO=dispatch@4starcleaning.com

# Application Base URL (used for generating secure internal dashboard links)
APP_BASE_URL=https://4starcleaning.com
